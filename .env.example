# Contact form → email vía Resend (sin base de datos).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=techstackmssaravia@gmail.com
# Verified sender on your Resend-verified domain (ms-tech-stack.cloud).
CONTACT_FROM_EMAIL=MS SARAVIA TECH STACK <contacto@ms-tech-stack.cloud>
NEXT_PUBLIC_SITE_URL=https://www.ms-tech-stack.cloud
# SEO — Google Search Console verification token (HTML tag, content="...").
# Optional: a default is hardcoded in layout.tsx. Set here only to override.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=ZHMlv0KexhXmR5QdCRqOuUup5_hLdeGAfvBv8i4RmcA
# SEO — Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX). Leave empty to disable GA4.
NEXT_PUBLIC_GA_ID=
# Analytics — Umami (self-hosted). Website-id y src son públicos; hay default hardcodeado
# en Analytics.tsx, así que estos solo hacen falta para override (staging, otro tenant, etc).
NEXT_PUBLIC_UMAMI_SRC=https://analytics.ms-tech-stack.cloud/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=ebe430c1-1311-466b-9010-6ac585752367
